#usda 1.0
(
    customLayerData = {
        string creator = "MuJoCo USD Converter v0.2.0"
    }
    defaultPrim = "microduck"
    doc = """Generated from Composed Stage of root layer /tmp/tmpysnkcave/microduck.usdc


Generated from Composed Stage of root layer /tmp/mjcf_import_robot_walk_5h2l5aup/usdex_robot_walk/microduck.usdc


Generated from Composed Stage of root layer /tmp/mjcf_import_robot_walk_5h2l5aup/temp_robot_walk/robot_walk.usd


Generated from Composed Stage of root layer /home/panda/robotics_ws/microduck_isaaclab/microduck_usd/robot_walk/payloads/base.usd
"""
    kilogramsPerUnit = 1
    metersPerUnit = 1
    subLayers = [
        @./physics.usda@
    ]
    upAxis = "Z"
)

over "microduck"
{
    over "Geometry"
    {
        over "trunk_base"
        {
            over "yaw2roll"
            {
                over "hip_l"
                {
                    over "upper_leg_left"
                    {
                        over "leg"
                        {
                            over "ankle_left" (
                                prepend apiSchemas = ["PhysxContactReportAPI"]
                            )
                            {
                                float physxContactReport:threshold = 0.0

                                over "left_ankle" (
                                    prepend apiSchemas = ["PhysxJointAPI"]
                                )
                                {
                                    float physxJoint:armature = 0.0018
                                    float physxJoint:jointFriction = 0.0048
                                }
                            }

                            over "left_knee" (
                                prepend apiSchemas = ["PhysxJointAPI"]
                            )
                            {
                                float physxJoint:armature = 0.0018
                                float physxJoint:jointFriction = 0.0048
                            }
                        }

                        over "left_hip_pitch" (
                            prepend apiSchemas = ["PhysxJointAPI"]
                        )
                        {
                            float physxJoint:armature = 0.0018
                            float physxJoint:jointFriction = 0.0048
                        }
                    }

                    over "left_hip_roll" (
                        prepend apiSchemas = ["PhysxJointAPI"]
                    )
                    {
                        float physxJoint:armature = 0.0018
                        float physxJoint:jointFriction = 0.0048
                    }
                }

                over "left_hip_yaw" (
                    prepend apiSchemas = ["PhysxJointAPI"]
                )
                {
                    float physxJoint:armature = 0.0018
                    float physxJoint:jointFriction = 0.0048
                }
            }

            over "neck"
            {
                over "neck_pitch_1"
                {
                    over "yaw_roll_motion"
                    {
                        over "jaw_soft"
                        {
                            over "head_roll" (
                                prepend apiSchemas = ["PhysxJointAPI"]
                            )
                            {
                                float physxJoint:armature = 0.0018
                                float physxJoint:jointFriction = 0.0048
                            }
                        }

                        over "head_yaw" (
                            prepend apiSchemas = ["PhysxJointAPI"]
                        )
                        {
                            float physxJoint:armature = 0.0018
                            float physxJoint:jointFriction = 0.0048
                        }
                    }

                    over "head_pitch" (
                        prepend apiSchemas = ["PhysxJointAPI"]
                    )
                    {
                        float physxJoint:armature = 0.0018
                        float physxJoint:jointFriction = 0.0048
                    }
                }

                over "neck_pitch" (
                    prepend apiSchemas = ["PhysxJointAPI"]
                )
                {
                    float physxJoint:armature = 0.0018
                    float physxJoint:jointFriction = 0.0048
                }
            }

            over "bearing_roll"
            {
                over "hip_l_2"
                {
                    over "upper_leg_right"
                    {
                        over "leg_2"
                        {
                            over "ankle_right" (
                                prepend apiSchemas = ["PhysxContactReportAPI"]
                            )
                            {
                                float physxContactReport:threshold = 0.0

                                over "right_ankle" (
                                    prepend apiSchemas = ["PhysxJointAPI"]
                                )
                                {
                                    float physxJoint:armature = 0.0018
                                    float physxJoint:jointFriction = 0.0048
                                }
                            }

                            over "right_knee" (
                                prepend apiSchemas = ["PhysxJointAPI"]
                            )
                            {
                                float physxJoint:armature = 0.0018
                                float physxJoint:jointFriction = 0.0048
                            }
                        }

                        over "right_hip_pitch" (
                            prepend apiSchemas = ["PhysxJointAPI"]
                        )
                        {
                            float physxJoint:armature = 0.0018
                            float physxJoint:jointFriction = 0.0048
                        }
                    }

                    over "right_hip_roll" (
                        prepend apiSchemas = ["PhysxJointAPI"]
                    )
                    {
                        float physxJoint:armature = 0.0018
                        float physxJoint:jointFriction = 0.0048
                    }
                }

                over "right_hip_yaw" (
                    prepend apiSchemas = ["PhysxJointAPI"]
                )
                {
                    float physxJoint:armature = 0.0018
                    float physxJoint:jointFriction = 0.0048
                }
            }
        }
    }
}

